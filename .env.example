# Default is SQLite at ~/.cardwise/cardwise.db — nothing to configure.

# Precedence: explicit path arg > DATABASE_URL > CARDWISE_DB > default.
# CARDWISE_DB=/absolute/path/to/cardwise.db
# CARDWISE_DATA=/absolute/path/to/statements
# CARDWISE_CATEGORIES=/absolute/path/to/categories.yaml

# Postgres (matches docker-compose.yml):
# DATABASE_URL=postgresql+psycopg://cardwise:cardwise@localhost:5432/cardwise
